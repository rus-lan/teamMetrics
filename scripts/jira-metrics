#!/usr/bin/env python3
"""Executable dispatcher for the jira-metrics tool: init / check / run / report.

Works from any working directory — it locates its own `jira_metrics` package
directory via __file__ before importing, the same way tests/_pathfix.py does,
so no PYTHONPATH setup or install step is needed. See SKILL.md for the full
command reference.
"""

import os
import sys

_SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
if _SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, _SCRIPTS_DIR)

from jira_metrics import cli  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(cli.main(sys.argv[1:], invocation=sys.argv[0]))
